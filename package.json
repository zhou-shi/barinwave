{
    "name": "brainwave",
    "version": "3.0.0",
    "description": "Brainwave theme for Hugo with Preact & Radix",
    "type": "module",
    "scripts": {
        "_comment1": "--- 1. BUILDERS (Core Engines) ---",
        "scan:server": "tsx islands/core/scan-server.ts",
        "build:server": "npm run scan:server && tsx islands/core/build-server.ts",
        "build:client": "tsx islands/core/build-client.ts",

        "_comment2": "--- 2. UTILITIES ---",
        "generate": "npx concurrently \"npm run build:server\" \"npm run build:client\"",
        "dev:css": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./assets/css/compiled/main.css --watch",
        "dev:hugo": "hugo server -D --disableFastRender --bind 0.0.0.0 --baseURL http://localhost:1313 --poll 700ms --source ../../",

        "_comment3": "--- 3. MAIN COMMANDS ---",
        "start": "npm run generate && npx concurrently \"npm run dev:css\" \"npm run dev:hugo\" \"npm run build:server -- --watch\" --names \"CSS,HUGO,STATIC\" --prefix-colors \"blue,magenta,yellow\"",
        "build": "npm run generate && NODE_ENV=production npx @tailwindcss/cli -i ./assets/css/main.css -o ./assets/css/compiled/main.css --minify"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/zhou-shi/brainwave.git"
    },
    "keywords": [
        "hugo",
        "hugo-theme",
        "tailwind",
        "preact",
        "radix-ui"
    ],
    "author": {
        "name": "Zhou Shi",
        "github": "https://github.com/zhou-shi"
    },
    "dependencies": {
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-navigation-menu": "^1.2.14",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@splinetool/react-spline": "^4.1.0",
        "@splinetool/runtime": "^1.12.23",
        "@supabase/supabase-js": "^2.90.0",
        "chokidar": "^5.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.2.3",
        "framer-motion": "^12.23.26",
        "glob": "^13.0.0",
        "gray-matter": "^4.0.3",
        "lucide-react": "^0.562.0",
        "motion": "^12.23.26",
        "preact": "^10.19.3",
        "preact-render-to-string": "^6.3.1",
        "react": "npm:@preact/compat",
        "react-dom": "npm:@preact/compat",
        "react-hook-form": "^7.70.0"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.1.17",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.19",
        "@types/node": "^25.0.2",
        "concurrently": "^9.1.2",
        "tailwind-merge": "^3.4.0",
        "tailwind-scrollbar": "^4.0.2",
        "tailwindcss": "^4.1.17",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}
